#!/usr/bin/env bash
# pre-commit (core.hooksPath=.githooks, ставится scripts/setup-dev.sh):
# запрет коммита в main + ruff по staged .py. Быстро (<2 с); полный гейт — в pre-push.
set -euo pipefail
branch=$(git branch --show-current)
if [[ "$branch" == main || "$branch" == master ]]; then
  echo "pre-commit: коммит в $branch запрещён — git switch -c <type>/<name>" >&2; exit 1
fi
files=()  # без mapfile: на macOS системный bash 3.2
while IFS= read -r f; do files+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
(( ${#files[@]} == 0 )) && exit 0
uvx ruff check "${files[@]}"
uvx ruff format --check "${files[@]}" || { echo "pre-commit: запусти uvx ruff format ${files[*]}" >&2; exit 1; }
