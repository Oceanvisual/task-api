# Обязательный секрет (OpenRouter / совместимый OpenAI API)
LLM_API_KEY=

# LLM (дефолты совпадают с app.config.Settings)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_TEMPERATURE=0.0

# Vector store (с хоста — localhost; в docker-compose — http://qdrant:6333)
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=sklearn_docs
TOP_K=4

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
NORMALIZE_EMBEDDINGS=true
